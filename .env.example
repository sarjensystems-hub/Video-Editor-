# Copy to .env.local for local development, and set the same values in the
# Vercel project's Environment Variables for the deployed app.

# ── Supabase ──────────────────────────────────────────────────────────────
# From the Supabase dashboard: Project Settings → API. The service-role key
# is server-only and must never be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenRouter (optional fallback) ────────────────────────────────────────
# Each account brings its own OpenRouter key, saved in Settings → API keys and
# stored encrypted (see supabase/add_user_api_keys.sql). Leave this blank and
# every user pays for their own generation, which is the intended setup.
#
# Set it only if you want a shared key to cover accounts that have not added
# one — it is billed to you for every such user, so treat it as a migration
# aid rather than a default.
OPENROUTER_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────
# The deployment's own address, with no trailing slash. It is what the MCP
# connector URL and the OAuth redirects are built from, so it has to match
# the domain people actually visit.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Optional video-model override; defaults to bytedance/seedance-2.0-fast.
VIDEO_DEFAULT_MODEL=bytedance/seedance-2.0-fast

# ── Secret encryption ─────────────────────────────────────────────────────
# Encrypts the OpenRouter key each user saves, before it is written to the
# database. Required for bring-your-own-key. 32 raw bytes as 64 hex chars or
# base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Rotating it makes every stored key undecryptable, and each user has to paste
# theirs again — so keep it somewhere you will not lose it.
API_KEY_ENCRYPTION_KEY=

# Older name for the same thing, still read as a fallback if the above is unset.
OAUTH_TOKEN_KEY=

# ── Cloudflare R2 (optional media storage) ────────────────────────────────
# This deployment stores media in Supabase Storage by default (see
# supabase/add_storage_buckets.sql) and leaves these unset. Fill in all five
# only if you want generated images, voiceover, music and finished MP4s
# routed to Cloudflare R2 instead — the bucket needs public read access
# either way, since the renderer and the connected LLM fetch assets over
# plain HTTPS.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Email (password resets and sign-in links) ─────────────────────────────
# Any SMTP account works. For Gmail, use an App Password rather than the
# account password, with host smtp.gmail.com and port 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
