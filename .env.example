# Copy to .env.local for local development, and set the same values in the
# Vercel project's Environment Variables for the deployed app.

# ── Supabase ──────────────────────────────────────────────────────────────
# From the Supabase dashboard: Project Settings → API. The service-role key
# is server-only and must never be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── OpenRouter ────────────────────────────────────────────────────────────
# One key pays for everything the app generates: text, images, speech, music
# and video. This is the account that gets billed, so keep it server-side.
OPENROUTER_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────
# The deployment's own address, with no trailing slash. It is what the MCP
# connector URL and the OAuth redirects are built from, so it has to match
# the domain people actually visit.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Optional video-model override; defaults to bytedance/seedance-2.0-fast.
VIDEO_DEFAULT_MODEL=bytedance/seedance-2.0-fast

# ── OAuth token encryption ────────────────────────────────────────────────
# Encrypts the tokens issued to MCP clients. 32 raw bytes as 64 hex chars or
# base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_TOKEN_KEY=

# ── Cloudflare R2 (optional media storage) ────────────────────────────────
# This deployment stores media in Supabase Storage by default (see
# supabase/add_storage_buckets.sql) and leaves these unset. Fill in all five
# only if you want generated images, voiceover, music and finished MP4s
# routed to Cloudflare R2 instead — the bucket needs public read access
# either way, since the renderer and the connected LLM fetch assets over
# plain HTTPS.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Email (password resets and sign-in links) ─────────────────────────────
# Any SMTP account works. For Gmail, use an App Password rather than the
# account password, with host smtp.gmail.com and port 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
